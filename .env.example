# Copy to .env and keep .env private
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
QA_ALERT_ADMIN_USERNAME=your-admin-username
QA_ALERT_ADMIN_PASSWORD=your-private-password

# Local transcription - no paid API
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=float32
WHISPER_LANGUAGE=auto
QA_TRANSCRIPTION_POLL_SECONDS=3
